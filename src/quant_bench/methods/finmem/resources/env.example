# LLM and embedding API. DASHSCOPE_API_KEY is preferred for the current
# DashScope-compatible configuration; OPENAI_API_KEY is also supported.
DASHSCOPE_API_KEY=
OPENAI_API_KEY=

# OKX demo-trading credentials (required for OKX simulated orders).
OKX_API_KEY_SIMU=
OKX_SECRET_KEY_SIMU=
OKX_PASSPHRASE=

# Local services and live runner settings.
QDRANT_ENDPOINT=http://localhost:6333
LIVE_MODEL=qwen3-max

# Safe default: build decisions and update the local virtual ledger without
# submitting an order. Set FINMEM_EXECUTE_ORDER=1 only for OKX demo trading.
FINMEM_EXECUTE_ORDER=0
FINMEM_VIRTUAL_PAPER_SHORT_MODE=0
FINMEM_IS_SIMULATED=1

# Set to 1 when local proxy variables break embedding requests.
EMBEDDING_DISABLE_PROXY=0

# Real-account credentials are intentionally omitted. The documented workflow
# supports backtests and OKX demo trading only.
